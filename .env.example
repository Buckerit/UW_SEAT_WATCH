APP_ENV=local
APP_DEBUG=false
APP_NAME=UW Seat Watch
LOG_LEVEL=INFO

# Use a generated secret locally; never commit your real production secret.
SECRET_KEY=replace-me-with-a-long-random-secret

BASE_URL=http://127.0.0.1:8000
CONTACT_EMAIL=your-email@example.com

DATABASE_URL=sqlite:///./uw_seat_watch.db

EMAIL_BACKEND=console
RESEND_API_KEY=
FROM_EMAIL=UW Seat Watch <alerts@example.com>

WATERLOO_SCHEDULE_URL=https://classes.uwaterloo.ca/cgi-bin/cgiwrap/infocour/salook.pl
WATERLOO_REQUEST_TIMEOUT_SECONDS=15

POLL_MINUTES=1,31
POLL_START_HOUR=8
POLL_END_HOUR=20
TIMEZONE=America/Toronto
